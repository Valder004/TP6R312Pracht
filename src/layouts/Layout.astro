---
import "../styles/global.css";
import penguins from "../assets/penguins.json";
const { title = "TP2 Penguins" } = Astro.props;
const species = [...new Set(penguins.map((penguin) => penguin.species))];
const currentPath = Astro.url.pathname;

---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | TP3 Penguins</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">TP3 <span>Data</span></a>
      <nav class="main-navigation" aria-label="Navigation principale">
        <a class:list={["navigation-home", { "is-current": currentPath === "/" }]} href="/" aria-current={currentPath === "/" ? "page" : undefined}>Accueil</a>
        <details class="navigation-group">
          <summary>Manchots</summary>
          <div class="navigation-menu">
            <span class="navigation-heading">Explorer les données</span>
            <a href="/penguins/" aria-current={currentPath === "/penguins/" ? "page" : undefined}>Vue d’ensemble</a>
            <a href="/penguins-filter/" aria-current={currentPath === "/penguins-filter/" ? "page" : undefined}>Filtrer par espèce</a>
            <a href="/penguins-filters/" aria-current={currentPath === "/penguins-filters/" ? "page" : undefined}>Combiner les filtres</a>
            <span class="navigation-heading">Comparer les espèces</span>
            <a href="/species/" aria-current={currentPath === "/species/" ? "page" : undefined}>Défilement des graphiques</a>
            <a href="/species-tabs/" aria-current={currentPath === "/species-tabs/" ? "page" : undefined}>Onglets accessibles</a>
            <a href="/penguins/specie/" aria-current={currentPath.startsWith("/penguins/specie") ? "page" : undefined}>Toutes les espèces</a>
            {species.map((item) => (
              <a class="navigation-subitem" href={`/penguins/specie/${item}/`} aria-current={currentPath === `/penguins/specie/${item}/` ? "page" : undefined}>{item}</a>
            ))}
            <span class="navigation-heading">Regrouper par</span>
            <a href="/penguins/island/" aria-current={currentPath.startsWith("/penguins/island") ? "page" : undefined}>Île</a>
            <a href="/penguins/sex/" aria-current={currentPath.startsWith("/penguins/sex") ? "page" : undefined}>Sexe</a>
          </div>
        </details>
        <details class="navigation-group">
          <summary>Automobiles</summary>
          <div class="navigation-menu">
            <a href="/cars/" aria-current={currentPath === "/cars/" ? "page" : undefined}>Vue d’ensemble</a>
            <a href="/cars/cylinders/" aria-current={currentPath.startsWith("/cars/cylinders") ? "page" : undefined}>Par nombre de cylindres</a>
          </div>
        </details>
        <details class="navigation-group">
          <summary>Cétacés</summary>
          <div class="navigation-menu">
            <a href="/cachalots/" aria-current={currentPath === "/cachalots/" ? "page" : undefined}>Cachalots — graphiques</a>
            <a href="/species/Orques/" aria-current={currentPath === "/species/Orques/" ? "page" : undefined}>Orques</a>
            <a href="/species/Cachalots/" aria-current={currentPath === "/species/Cachalots/" ? "page" : undefined}>Cachalots — fiche</a>
          </div>
        </details>
        <details class="navigation-group">
          <summary>Exemples</summary>
          <div class="navigation-menu">
            <a href="/simple/" aria-current={currentPath === "/simple/" ? "page" : undefined}>Graphique simple</a>
          </div>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <footer>TP3 R312</footer>
  </body>
</html>

<script>
  const navigationGroups = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".navigation-group"),
  );

  navigationGroups.forEach((group) => {
    group.addEventListener("toggle", () => {
      if (!group.open) return;

      navigationGroups.forEach((otherGroup) => {
        if (otherGroup !== group) otherGroup.open = false;
      });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>(".navigation-menu a").forEach((link) => {
    link.addEventListener("click", () => {
      const group = link.closest<HTMLDetailsElement>(".navigation-group");
      if (group) group.open = false;
    });
  });
</script>
